{
  "name": "dsh-chapters",
  "version": "0.0.1",
  "description": "dsh plugin: verbatim chapter archive + zero-token index for small-context models",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./engine": "./lib/engine.js",
    "./presets/*": "./presets/*",
    "./tools": "./lib/tools.js",
    "./store": "./lib/store.js",
    "./registry": "./lib/registry.js"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
